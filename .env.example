# LLM API 配置（兼容 OpenAI 格式的 API）
# 从 https://www.ohmygpt.com/apis/keys 获取你的 API Key
LLM_API_KEY=sk-xxx-your-ohmygpt-api-key-here
LLM_BASE_URL=https://api.ohmygpt.com/v1

# App Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/pingpong.db

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Ball Tracking Configuration
BALL_TRACKING_UPLOAD_DIR=./data/uploads/videos
BALL_TRACKING_OUTPUT_DIR=./data/outputs/ball_tracking
BALL_TRACKING_MAX_FILE_SIZE_MB=500

# BlurBall Model
BLURBALL_CONFIG_NAME=inference_blurball
BLURBALL_CHECKPOINT_PATH=./external/blurball/checkpoints/blurball.ckpt

# Ball Tracking Processing
BALL_TRACKING_BATCH_SIZE=16
BALL_TRACKING_DETECTION_THRESHOLD=0.5
BALL_TRACKING_MAX_GAP_FRAMES=5
